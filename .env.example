# Earde configuration. Every variable the application and the realtime gateway
# read is listed here. Nothing reads this file by itself: copy it to .env (which
# is git-ignored), fill it in, and export it into your shell before starting
# the server:
#
#   cp .env.example .env
#   set -a; . ./.env; set +a
#
# The values below are for local development only. Never commit real secrets.

# --- Required -------------------------------------------------------------

# PostgreSQL connection for the web application (and for dbmate).
DATABASE_URL=postgres://earde:earde@localhost:5432/earde_dev?sslmode=disable

# --- Core (optional; defaults shown) ------------------------------------------

# Key for sessions, CSRF tokens and encrypted cookies. Unset: a random key
# per process, so sessions end at every restart. In production set a stable
# value, e.g. from:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# DREAM_SECRET=

# Interface to listen on (the port is fixed at 8080). Default: localhost.
# HOST=localhost

# Public base URL used in links inside e-mails. Default: http://localhost:8080.
BASE_URL=http://localhost:8080

# Public https origin of the deployment, e.g. https://earde.example. When it is
# https, session cookies are marked Secure. Also required by the GitHub
# integration and by analytics.
# EARDE_PUBLIC_ORIGIN=

# Addresses of reverse proxies whose X-Forwarded-For is trusted (comma-separated).
# Default: 127.0.0.1 and ::1.
# EARDE_TRUSTED_PROXIES=127.0.0.1,::1

# Database pool size. Default: 32. Must be a positive integer.
# DB_POOL_SIZE=32

# --- Accounts and mail --------------------------------------------------------

# Public signup is closed unless this is 1, true, yes or on.
EARDE_SIGNUPS_ENABLED=true

# Brevo (transactional e-mail) API key. Unset: no mail is sent; the server logs
# that it would have sent one. The sender is noreply@earde.com (lib/email.ml).
# BREVO_API_KEY=

# Development only: with BREVO_API_KEY unset, print verification and reset
# links in the server log. Anyone who can read the log can use those links.
EARDE_LOG_TOKENS=1

# Cloudflare Turnstile on signup. Without keys no challenge is shown. With
# EARDE_TURNSTILE_REQUIRED truthy, missing keys make signup fail closed.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# EARDE_TURNSTILE_REQUIRED=false

# --- Realtime gateway (optional) ------------------------------------------------

# Without these, chat still works over HTTP; pages just do not update live.
# Both secrets must be the same for the application and the gateway.
# REALTIME_GATEWAY_URL=http://127.0.0.1:8090
# REALTIME_SOCKET_URL=ws://localhost:8090/socket
# REALTIME_INTERNAL_SECRET=change-me-local-internal-secret
# REALTIME_TOKEN_SECRET=change-me-local-token-secret

# Read by the gateway only: page origins allowed to open WebSockets
# (comma-separated). Needed locally because the app (8080) and the gateway
# (8090) are different origins.
# REALTIME_ALLOWED_ORIGINS=http://localhost:8080

# Community slugs where shared cursors are enabled (comma-separated).
# Default: beryl.
# EARDE_SHARED_CURSOR_COMMUNITIES=

# --- GitHub project onboarding (optional; off by default) ---------------------

# off (default), admins or public. Any other value means off.
# EARDE_GITHUB_ONBOARDING_ENABLED=off
# The GitHub App used for onboarding. The two URLs must be on
# EARDE_PUBLIC_ORIGIN with exactly these paths.
# GITHUB_APP_SLUG=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_SETUP_URL=https://earde.example/integrations/github/install/return
# GITHUB_APP_CALLBACK_URL=https://earde.example/integrations/github/authorize/callback

# --- Product analytics (optional; off by default) -------------------------------

# PostHog. Anything but POSTHOG_ENABLED=true keeps analytics off, and then no
# other analytics variable is needed. When enabled, every variable below is
# required and validated.
# - production: the origin must be exactly https://earde.com (lib/analytics.ml);
# - staging: any other https origin;
# - development: needs POSTHOG_ALLOW_DEVELOPMENT=true and a loopback origin.
# See docs/features/posthog-analytics.md.
# POSTHOG_ENABLED=false
# EARDE_DEPLOYMENT_ENVIRONMENT=development
# POSTHOG_ALLOW_DEVELOPMENT=false
# POSTHOG_PROJECT_TOKEN=
# POSTHOG_PROJECT_ID=
# POSTHOG_PERSONAL_API_KEY=
# POSTHOG_API_HOST=https://eu.i.posthog.com
# POSTHOG_UI_HOST=https://eu.posthog.com

# --- Tests -------------------------------------------------------------------

# A disposable, migrated database for the gated test cases. Unset: those
# cases are skipped. The cases create and delete their own rows.
# EARDE_TEST_DATABASE_URL=postgresql://earde:earde@localhost:5432/earde_test
