(include_subdirs unqualified)

(test
 (name test_earde)
 ; caqti libs are for the opt-in EARDE_TEST_DATABASE_URL security-regression
 ; suite only; without that env var no test touches a database.
 ; dream and yojson are referenced directly by the analytics tests (mock
 ; requests for the consent gate; payload JSON assertions). analytics.js is a
 ; dep so the replay-masking coverage test can read it from the sandbox, and
 ; the production sources + shipped stylesheets (the entrypoint and every
 ; partial) are deps so the legacy-asset and CSS censuses can read them.
 (deps
  ../static/js/analytics.js
  (glob_files_rec ../static/css/*.css)
  ../bin/main.ml
  (glob_files ../lib/*.ml)
  (glob_files ../lib/*.mli))
 ; cohttp-lwt-unix provides the local Persons-API stub server for the step-7
 ; deletion-client tests — no real network or PostHog access.
 (libraries
  earde
  alcotest
  caqti
  caqti-lwt
  caqti-lwt.unix
  caqti-driver-postgresql
  lwt
  lwt.unix
  unix
  uri
  dream
  yojson
  cohttp
  cohttp-lwt
  cohttp-lwt-unix)
 ; Referencing Earde.Handlers pulls in Auth's argon2 (ctypes) binding, which
 ; needs the system library linked explicitly — same flags as bin/dune.
 (link_flags
  (:standard -cclib -largon2)))
